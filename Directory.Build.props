<Project>

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>preview</LangVersion>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<AnalysisLevel>latest</AnalysisLevel>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
	</PropertyGroup>





	<!-- 👇 文件存在时 src\Shared\GlobalUsings.$(MSBuildProjectName).props 引入【全局命名空间引用】  -->
	<Import Condition="Exists('$(MSBuildThisFileDirectory)GlobalUsings.MSBuildProjectName.props')" Project="$(MSBuildThisFileDirectory)GlobalUsings.MSBuildProjectName.props" />
</Project>