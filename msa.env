# 本地开发共用的环境配置：所有服务启动时由 MSA.Common.MsaEnvironment 读取（从服务目录逐级向上找到这个文件）。
# 变量名与 docker/.env 一致，Docker 部署时由 compose 的 env_file 注入同名变量，代码只有一套读取流程。
# 已经设置的进程环境变量优先于这里的值，个人机器上的差异可以直接用环境变量覆盖，不必改这个文件。
#
# 格式：KEY=VALUE，# 开头为注释；值两端的单 / 双引号会被去掉；不做 ${} 插值。
# 各服务 appsettings.json 只保留属于自己的部分（库名 Database=、Redis 的 defaultDatabase=、队列名、ClientId），
# 这里的地址、账号、口令会合并进去，对应关系见 MsaEnvironment 的注释。

# ---- PostgreSQL → ConnectionStrings:Postgresql / DefaultConnection ----
INFRA_POSTGRES_HOST=192.168.1.50
INFRA_POSTGRES_PORT=5432
INFRA_POSTGRES_USER=postgres
INFRA_POSTGRES_PASSWORD='qwertAa!@#$'

# ---- Redis → ConnectionStrings:Redis ----
INFRA_REDIS_HOST=192.168.1.50
INFRA_REDIS_PORT=6379
INFRA_REDIS_PASSWORD='qwertAaQAQ'

# ---- RabbitMQ → RabbitMQ:* ----
INFRA_RABBITMQ_HOST=192.168.1.50
INFRA_RABBITMQ_PORT=5672
INFRA_RABBITMQ_USER=admin
INFRA_RABBITMQ_PASSWORD='qwertAa!@#$'
INFRA_RABBITMQ_VHOST=/app

# ---- 对象存储（MinIO / S3）→ ObjectStorage:*（后台 BFF）----
INFRA_OSS_ENDPOINT=http://192.168.1.50:9000
INFRA_OSS_ACCESS_KEY=lIsrAuRBWT0huAHS7Kzl
INFRA_OSS_SECRET_KEY=Nokx3fRO0InDWLMLeecvgO1LKZomBfpzG6C7NCmj

# ---- 服务间调用取令牌的授权地址 → ServiceAuthentication:Authority ----
MSA_SERVICE_AUTHORITY=https://localhost:10002/

# ---- 可观测性：OTLP gRPC 端点 → OpenTelemetry:OtlpEndpoint ----
MSA_OTLP_ENDPOINT=http://192.168.1.50:4317

# ---- gRPC 下游地址 → GrpcClients:<名称>:Address（按被调用的服务命名，调用它的服务共用一个变量）----
MSA_GRPC_ORDER_ADDRESS=https://localhost:10001
MSA_GRPC_CATALOG_ADDRESS=https://localhost:10003
MSA_GRPC_INVENTORY_ADDRESS=https://localhost:10004
MSA_GRPC_PAYMENT_ADDRESS=https://localhost:10005
MSA_GRPC_USER_ADDRESS=https://localhost:10010

# ---- OpenIddict 客户端密钥：MSA_CLIENT_SECRET_<ClientId 大写> ----
# 认证中心按它注册客户端（OpenIddict:Applications），各服务 / BFF 用它取令牌（ServiceAuthentication、OpenIddict），两边自然一致。
MSA_CLIENT_SECRET_MSA_BFF_WEB=945DED85-033B-46ED-9782-1F75212C5BC9
MSA_CLIENT_SECRET_MSA_BFF_BM=91ACD92D-1FC6-4B20-AA2B-1EAEF617B3E0
MSA_CLIENT_SECRET_MSA_SVC_ORDER=8C0609A4-794D-4062-93D9-E8FB47D22AE5
MSA_CLIENT_SECRET_MSA_SVC_BASKET=E4BC9CD0-A785-4569-A163-E4C43D7B221E
MSA_CLIENT_SECRET_MSA_SVC_PAYMENT=D6C4746D-A37D-42DE-899B-7662163A5436
MSA_CLIENT_SECRET_MSA_SVC_BFFWEB=65F1F34A-FE64-4FFE-95BA-21D5AFA71F82
MSA_CLIENT_SECRET_MSA_SVC_BFFBM=CFE04876-62A2-42DE-9962-8673F5EF1FA9
