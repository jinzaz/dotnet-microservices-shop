# 本地开发共用的环境配置：所有服务启动时由 MSA.Common.MsaEnvironment 读取（从服务目录逐级向上找到这个文件）。
# 变量名与 docker/.env 一致，Docker 部署时由 compose 的 env_file 注入同名变量，代码只有一套读取流程。
# 这个文件入库，只放能直接跑起来的本地默认值（localhost、镜像默认账号、仅供本地的随机密钥）。
# 自己机器上的地址与口令写进同目录的 msa.local.env（不入库，格式相同，只写要改的键），它优先于本文件；
# 已经设置的进程环境变量又优先于两者。
#
# 格式：KEY=VALUE，# 开头为注释；值两端的单 / 双引号会被去掉；不做 ${} 插值。
# 各服务 appsettings.json 只保留属于自己的部分（库名 Database=、Redis 的 defaultDatabase=、队列名、ClientId），
# 这里的地址、账号、口令会合并进去，对应关系见 MsaEnvironment 的注释。

# ---- PostgreSQL → ConnectionStrings:Postgresql / DefaultConnection ----
INFRA_POSTGRES_HOST=localhost
INFRA_POSTGRES_PORT=5432
INFRA_POSTGRES_USER=postgres
INFRA_POSTGRES_PASSWORD=postgres

# ---- Redis → ConnectionStrings:Redis ----
INFRA_REDIS_HOST=localhost
INFRA_REDIS_PORT=6379
INFRA_REDIS_PASSWORD=

# ---- RabbitMQ → RabbitMQ:* ----
INFRA_RABBITMQ_HOST=localhost
INFRA_RABBITMQ_PORT=5672
INFRA_RABBITMQ_USER=guest
INFRA_RABBITMQ_PASSWORD=guest
INFRA_RABBITMQ_VHOST=/

# ---- 对象存储（MinIO / S3）→ ObjectStorage:*（后台 BFF、订单服务）----
INFRA_OSS_ENDPOINT=http://localhost:9000
INFRA_OSS_ACCESS_KEY=minioadmin
INFRA_OSS_SECRET_KEY=minioadmin

# ---- Elasticsearch（商品搜索服务；需安装 IK 分词插件）→ Elasticsearch:* ----
# 还没部署 ES 时这里是占位地址：搜索服务照常启动，搜索接口返回 503、前台自动回退到目录的数据库搜索；
# 首次建索引在后台按退避重试，ES 一就绪就自动完成。本地开发要求 ES 用 compose.dev.yaml 把 9200 映射出来。
INFRA_ELASTICSEARCH_URL=http://localhost:9200
INFRA_ELASTICSEARCH_USER=elastic
INFRA_ELASTICSEARCH_PASSWORD=change-me
# INFRA_ELASTICSEARCH_API_KEY=
# ES 开了 TLS 时（见 docker/elasticsearch/compose.yaml 注释掉的配置）：改用 https，并指向从 ES 容器拷出来的 CA（Windows 路径照写）
# INFRA_ELASTICSEARCH_URL=https://localhost:9200
# INFRA_ELASTICSEARCH_CA_CERT=D:\path\to\docker\certs\es-http-ca.crt

# ---- 服务间调用取令牌的授权地址 → ServiceAuthentication:Authority ----
MSA_SERVICE_AUTHORITY=https://localhost:10002/

# ---- 可观测性：OTLP gRPC 端点 → OpenTelemetry:OtlpEndpoint ----
MSA_OTLP_ENDPOINT=http://localhost:4317

# ---- gRPC 下游地址 → GrpcClients:<名称>:Address（按被调用的服务命名，调用它的服务共用一个变量）----
MSA_GRPC_ORDER_ADDRESS=https://localhost:10001
MSA_GRPC_CATALOG_ADDRESS=https://localhost:10003
MSA_GRPC_INVENTORY_ADDRESS=https://localhost:10004
MSA_GRPC_PAYMENT_ADDRESS=https://localhost:10005
MSA_GRPC_USER_ADDRESS=https://localhost:10010

# ---- OpenIddict 客户端密钥：MSA_CLIENT_SECRET_<ClientId 大写> ----
# 认证中心按它注册客户端（OpenIddict:Applications），各服务 / BFF 用它取令牌（ServiceAuthentication、OpenIddict），两边自然一致。
MSA_CLIENT_SECRET_MSA_BFF_WEB_TEST=dev-365fcd0b75d4650f4716d7f7fc532ededa35539d116b9083
MSA_CLIENT_SECRET_MSA_BFF_BM_TEST=dev-0d7493b0458257db6b58c5f4b4944e26eadde35a95d2456c
MSA_CLIENT_SECRET_MSA_SVC_ORDER_TEST=dev-99fdb35e7a4dafc7689ae00216fab352312885eff760c908
MSA_CLIENT_SECRET_MSA_SVC_BASKET_TEST=dev-cab02af82528661f55e1efd69fc9d00249c5ae1d18e2b802
MSA_CLIENT_SECRET_MSA_SVC_PAYMENT_TEST=dev-c7a4df44653411c5b0db9a5c7184e8d9befeb378e753bee8
MSA_CLIENT_SECRET_MSA_SVC_BFFWEB_TEST=dev-9d94e6876103a8ffbbdf21f635816c04e7787842deb6c88f
MSA_CLIENT_SECRET_MSA_SVC_BFFBM_TEST=dev-18446916780117d52251fb13d57ec19e7639ada8f12c511b
MSA_CLIENT_SECRET_MSA_SVC_SEARCH_TEST=dev-e2c782d48d8683bce7224fc528338d50ff51d42895d04d8c

# ---- 证书库 KEK：MSA_CERT_KEK_<使用方>（32 字节 base64，openssl rand -base64 32）----
# 加密证书库里该使用方的私钥与 DataProtection 密钥环。证书服务需要全部四个，认证中心 / 两个 BFF 只用自己的那一个。
# 这里是本地开发用的值；生产环境在 docker/.env 里另行生成，换掉 KEK 后库里已有的私钥就解不开了。
MSA_CERT_KEK_IDENTITY=xP/2SRWSos7KRi/xZSFRnmCQKq8CcEUV6I6Zaclw/2g=
MSA_CERT_KEK_BFF_WEB=SCZTnS6z5pDvBoMCyhNyUaEz10F0bWSa9OfOuFHkyRw=
MSA_CERT_KEK_BFF_BM=CZaRsUj8pQzojlr44aycEnQd66Zj6nqn0LXlblGm5f8=
MSA_CERT_KEK_EDGE=hqMV80BIxQgilbK4YLH0Rk7jS0s6LrRdiVN2nne7D6Q=
