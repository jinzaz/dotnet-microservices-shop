{
  "ConnectionStrings": {
    "Postgresql": "Database=BasketDb"
  },
  "Basket": {
    "MaximumLineQuantity": 99,
    "MaximumDistinctItems": 100,
    "MaximumCouponCodes": 5
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Authentication": {
    "Issuer": "https://localhost:10002/"
  },
  "RabbitMQ": {
    "ExchangeName": "msa.commerce.events",
    "QueueName": "msa.basket",
    "PrefetchCount": 32
  },
  "ServiceAuthentication": {
    "ClientId": "MSA_Svc_Basket",
    "AllowUntrustedCertificates": false
  },
  "GrpcClients": {
    "Catalog": {
      "Scopes": [
        "catalog"
      ],
      "Deadline": "00:00:02"
    }
  },
  "AllowedHosts": "*"
}
