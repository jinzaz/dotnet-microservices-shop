{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgresql": "Database=OrderDb",
    "Redis": "defaultDatabase=5"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "OrderCheckout": {
    "PaymentWindow": "00:15:00"
  },
  "Authentication": {
    "Issuer": "https://localhost:10002/"
  },
  "AllowedHosts": "*",
  "RabbitMQ": {
    "QueueName": "msa.ordering"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://192.168.1.50:4317",
    "EnableConsoleExporter": true
  },
  "ServiceAuthentication": {
    "ClientId": "MSA_Svc_Order",
    "AllowUntrustedCertificates": false
  },
  "GrpcClients": {
    "Catalog": {
      "Address": "https://localhost:10003",
      "Scopes": [
        "catalog"
      ],
      "Deadline": "00:00:03"
    },
    "Inventory": {
      "Address": "https://localhost:10004",
      "Scopes": [
        "inventory"
      ],
      "Deadline": "00:00:02"
    },
    "Payment": {
      "Address": "https://localhost:10005",
      "Scopes": [
        "payment"
      ],
      "Deadline": "00:00:02"
    },
    "User": {
      "Address": "https://localhost:10010",
      "Scopes": [
        "user"
      ],
      "Deadline": "00:00:02"
    }
  }
}
