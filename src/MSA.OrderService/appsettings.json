{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgresql": "Database=OrderDb",
    "Redis": "defaultDatabase=5"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "OrderCheckout": {
    "PaymentWindow": "00:15:00"
  },
  "Authentication": {
    "Issuer": "https://localhost:10002/",
    "InternalAddress": "https://localhost:10002/"
  },
  "ObjectStorage": {
    "PrivateBucket": "shop-private"
  },
  "AfterSales": {
    "ReviewTimeout": "2.00:00:00",
    "ReturnShipmentTimeout": "7.00:00:00",
    "ReturnReceiptTimeout": "10.00:00:00",
    "RefundTimeout": "2.00:00:00",
    "ReplacementReceiptTimeout": "10.00:00:00",
    "DefaultReturnAddress": ""
  },
  "AllowedHosts": "*",
  "RabbitMQ": {
    "QueueName": "msa.ordering",
    "PrefetchCount": 64,
    "ConsumerDispatchConcurrency": 4
  },
  "OpenTelemetry": {
    "EnableConsoleExporter": true
  },
  "ServiceAuthentication": {
    "ClientId": "MSA_Svc_Order_Test",
    "AllowUntrustedCertificates": false
  },
  "GrpcClients": {
    "Catalog": {
      "Scopes": [
        "catalog"
      ],
      "Deadline": "00:00:03"
    },
    "Inventory": {
      "Scopes": [
        "inventory"
      ],
      "Deadline": "00:00:02"
    },
    "Payment": {
      "Scopes": [
        "payment"
      ],
      "Deadline": "00:00:02"
    },
    "User": {
      "Scopes": [
        "user"
      ],
      "Deadline": "00:00:02"
    }
  }
}
