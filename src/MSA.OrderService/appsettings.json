{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgresql": "Database=OrderDb",
    "Redis": "defaultDatabase=5"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "OrderCheckout": {
    "PaymentWindow": "00:15:00"
  },
  "Authentication": {
    "Issuer": "https://localhost:10002/",
    "InternalAddress": "https://localhost:10002/"
  },
  "AllowedHosts": "*",
  "RabbitMQ": {
    "QueueName": "msa.ordering"
  },
  "OpenTelemetry": {
    "EnableConsoleExporter": true
  },
  "ServiceAuthentication": {
    "ClientId": "MSA_Svc_Order",
    "AllowUntrustedCertificates": false
  },
  "GrpcClients": {
    "Catalog": {
      "Scopes": [
        "catalog"
      ],
      "Deadline": "00:00:03"
    },
    "Inventory": {
      "Scopes": [
        "inventory"
      ],
      "Deadline": "00:00:02"
    },
    "Payment": {
      "Scopes": [
        "payment"
      ],
      "Deadline": "00:00:02"
    },
    "User": {
      "Scopes": [
        "user"
      ],
      "Deadline": "00:00:02"
    }
  }
}
