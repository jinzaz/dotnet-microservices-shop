{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Issuer": "https://localhost:10002/",
    "Audience": "api"
  },
  "ReverseProxy": {
    "Routes": {
      //"order-canary": {
      //  "ClusterId": "order-canary",
      //  "Order": -10,
      //  "Match": {
      //    "Path": "/order/{**catch-all}",
      //    "Headers": [
      //      {
      //        "Name": "X-Canary",
      //        "Values": [ "true" ],
      //        "Mode": "ExactHeader"
      //      } //灰度发布，只有请求头中带有 X-Canary: true 的请求才会走 canary 路由
      //    ]
      //  },
      //  "Transforms": [ { "PathRemovePrefix": "/order" } ]
      //},
      "order-default": {
        "ClusterId": "order-stable",
        "Match": { "Path": "/order/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/order" } ]
      },
      "identity-default": {
        "ClusterId": "identity",
        "Match": { "Path": "/identity/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/identity" } ]
      },
      "basket-default": {
        "ClusterId": "basket",
        "Match": { "Path": "/basket/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/basket" } ]
      },
      "catalog-default": {
        "ClusterId": "catalog",
        "Match": { "Path": "/catalog/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/catalog" } ]
      },
      "inventory-default": {
        "ClusterId": "inventory",
        "Match": { "Path": "/inventory/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/inventory" } ]
      },
      "payment-default": {
        "ClusterId": "payment",
        "Match": { "Path": "/payment/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/payment" } ]
      },
      "notification-default": {
        "ClusterId": "notification",
        "Match": { "Path": "/notification/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/notification" } ]
      }
    },
    "Clusters": {
      "order-stable": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "Destinations": {
          "order-1": { "Address": "https://localhost:10001/" },
          //"order-2": { "Address": "https://localhost:10101/" }
        },
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health" },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "HttpRequest": { "ActivityTimeout": "00:00:30", "Version": "2", "VersionPolicy": "RequestVersionOrLower" }
      },
      "order-canary": {
        "Destinations": { "order-canary-1": { "Address": "https://localhost:11001/" } },
        "HttpRequest": { "ActivityTimeout": "00:00:30" }
      },
      "identity": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "Destinations": { "identity-1": { "Address": "https://localhost:10002/" } },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "HttpRequest": { "ActivityTimeout": "00:00:15" }
      },
      "basket": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "Destinations": { "basket-1": { "Address": "https://localhost:10007/" } },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "HttpRequest": { "ActivityTimeout": "00:00:15" }
      },
      "catalog": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "Destinations": { "catalog-1": { "Address": "https://localhost:10003/" } },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "HttpRequest": { "ActivityTimeout": "00:00:15" }
      },
      "inventory": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "Destinations": { "inventory-1": { "Address": "https://localhost:10004/" } },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "HttpRequest": { "ActivityTimeout": "00:00:10" }
      },
      "payment": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "Destinations": { "payment-1": { "Address": "https://localhost:10005/" } },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "HttpRequest": { "ActivityTimeout": "00:00:30" }
      },
      "notification": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "Destinations": { "notification-1": { "Address": "https://localhost:10006/" } },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "HttpRequest": { "ActivityTimeout": "00:00:15" }
      }
    }
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317",
    "EnableConsoleExporter": false
  }
}
