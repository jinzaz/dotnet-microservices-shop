{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgresql": "Host=192.168.1.50;Port=5432;Database=apigateway;Username=postgres;Password=qwer12153",
    "Redis": "192.168.1.50:6379,user=default,password=qwertAa!@#"
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "route-canary": {
        "ClusterId": "orderServiceCanaryCluster",
        "Match": {
          "Path": "/order/{**catch-all}",
          "Headers": [ { "Name": "X-Canary", "Values": ["true"], "Mode": "ExactHeader" } ]
        }
      },
      "route-default": {
        "ClusterId": "orderServiceCluster",
        "Match": {
          "Path": "/order/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "LoadBalancingPolicy": "PowerOfTwoChoices",
      "orderServiceCluster": {
        "Destinations": {
          "cluster1/destination1": {
            "Address": "https://localhost:10001/"
          }
        }
      },
      "orderServiceCanaryCluster": {
        "Destinations": {
          "cluster1/destination1": {
            "Address": "https://localhost:11001/"
          }
        }
      },
      "HealthCheck": {
        "Active": { // Makes API calls to validate the health
          "Enabled": "true",
          "Interval": "00:00:10",
          "Timeout": "00:00:10",
          "Policy": "ConsecutiveFailures",
          "Path": "/api/health", // API endpoint to query for health state
          "Query": "?foo=bar"
        },
        "Passive": { // Disables destinations based on HTTP response codes
          "Enabled": true, // Default is false
          "Policy": "TransportFailureRateHealthPolicy", // Required
          "ReactivationPeriod": "00:00:10" // 10s
        }
      },
      "HttpClient": { // Configuration of HttpClient instance used to contact destinations
        "SSLProtocols": "Tls13",
        "DangerousAcceptAnyServerCertificate": false,
        "MaxConnectionsPerServer": 1024,
        "EnableMultipleHttp2Connections": true,
        "RequestHeaderEncoding": "Latin1", // How to interpret non ASCII characters in request header values
        "ResponseHeaderEncoding": "Latin1" // How to interpret non ASCII characters in response header values
      },
      "HttpRequest": { // Options for sending request to destination
        "ActivityTimeout": "00:02:00",
        "Version": "2",
        "VersionPolicy": "RequestVersionOrLower",
        "AllowResponseBuffering": "false"
      }
    }

  ,"Consul": {
    "Address": "http://localhost:8500"
  },
  "RabbitMQ": {
    "Host": "192.168.1.50",
    "Port": 5672,
    "User": "admin",
    "Password": "qwertAa!@#"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317",
    "EnableConsoleExporter": true
  }
  }
}
