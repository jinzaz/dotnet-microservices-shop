{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Yarp.ReverseProxy": "Information" } },
  "AllowedHosts": "*",
  "Authentication": { "Issuer": "https://localhost:10002/", "Audience": "api" },
  "ReverseProxy": {
    "Routes": {
      "order-canary": {
        "ClusterId": "order-canary",
        "Order": -10,
        "Match": { "Path": "/order/{**catch-all}", "Headers": [ { "Name": "X-Canary", "Values": [ "true" ], "Mode": "ExactHeader" } ] }
      },
      "order-default": { "ClusterId": "order-stable", "Match": { "Path": "/order/{**catch-all}" } }
    },
    "Clusters": {
      "order-stable": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "Destinations": { "order-1": { "Address": "https://localhost:10001/" } },
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health" },
          "Passive": { "Enabled": true, "Policy": "TransportFailureRateHealthPolicy", "ReactivationPeriod": "00:00:30" }
        },
        "HttpRequest": { "ActivityTimeout": "00:00:30", "Version": "2", "VersionPolicy": "RequestVersionOrLower" }
      },
      "order-canary": {
        "Destinations": { "order-canary-1": { "Address": "https://localhost:11001/" } },
        "HttpRequest": { "ActivityTimeout": "00:00:30" }
      }
    }
  },
  "OpenTelemetry": { "OtlpEndpoint": "http://localhost:4317", "EnableConsoleExporter": true }
}
