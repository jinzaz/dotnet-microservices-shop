{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Issuer": "https://localhost:10002/",
    "InternalAddress": "https://localhost:10002/",
    "Audience": "api"
  },
  "ReverseProxy": {
    "Routes": {
      //"order-canary": {
      //  "ClusterId": "order-canary",
      //  "Order": -10,
      //  "Match": {
      //    "Path": "/api/order/{**catch-all}",
      //    "Headers": [
      //      {
      //        "Name": "X-Canary",
      //        "Values": [ "true" ],
      //        "Mode": "ExactHeader"
      //      } //灰度发布，只有请求头中带有 X-Canary: true 的请求才会走 canary 路由
      //    ]
      //  },
      //  "Transforms": [ { "PathRemovePrefix": "/api" } ]
      //},
      "order-default": {
        "ClusterId": "order-stable",
        "Match": { "Path": "/api/order/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "identity-default": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/Auth/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "identity-OpenIddict": {
        "ClusterId": "identity",
        "Match": { "Path": "/connect/{**catch-all}" }
      },
      "user-default": {
        "ClusterId": "user",
        "Match": { "Path": "/api/user/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "basket-default": {
        "ClusterId": "basket",
        "Match": { "Path": "/api/basket/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "catalog-default": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/catalog/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "inventory-default": {
        "ClusterId": "inventory",
        "Match": { "Path": "/api/inventory/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "payment-default": {
        "ClusterId": "payment",
        "Match": { "Path": "/api/payment/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "notification-default": {
        "ClusterId": "notification",
        "Match": { "Path": "/api/notification/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      }
    },
    "Clusters": {
      "order-stable": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "Destinations": {
          "order-1": { "Address": "https://localhost:10001/" }
          //"order-2": { "Address": "https://localhost:10101/" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30",
          "Version": "2",
          "VersionPolicy": "RequestVersionOrLower"
        }
      },
      "order-canary": {
        "Destinations": { "order-canary-1": { "Address": "https://localhost:11001/" } },
        "HttpRequest": { "ActivityTimeout": "00:00:30" }
      },
      "identity": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "Destinations": { "identity-1": { "Address": "https://localhost:10002/" } },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "HttpRequest": { "ActivityTimeout": "00:00:15" }
      },
      "user": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "Destinations": { "user-1": { "Address": "https://localhost:10010/" } },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "HttpRequest": { "ActivityTimeout": "00:00:15" }
      },
      "basket": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "Destinations": { "basket-1": { "Address": "https://localhost:10007/" } },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "HttpRequest": { "ActivityTimeout": "00:00:15" }
      },
      "catalog": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "Destinations": { "catalog-1": { "Address": "https://localhost:10003/" } },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "HttpRequest": { "ActivityTimeout": "00:00:15" }
      },
      "inventory": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "Destinations": { "inventory-1": { "Address": "https://localhost:10004/" } },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "HttpRequest": { "ActivityTimeout": "00:00:10" }
      },
      "payment": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "Destinations": { "payment-1": { "Address": "https://localhost:10005/" } },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "HttpRequest": { "ActivityTimeout": "00:00:30" }
      },
      "notification": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "Destinations": { "notification-1": { "Address": "https://localhost:10006/" } },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
