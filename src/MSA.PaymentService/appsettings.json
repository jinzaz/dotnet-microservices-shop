{
  "ConnectionStrings": {
    "Postgresql": "Database=PaymentDb",
    "Redis": "defaultDatabase=6"
  },
  "Database": { "MigrateOnStartup": false },
  "Authentication": { "Issuer": "https://localhost:10002/", "InternalAddress": "https://localhost:10002/" },
  "RabbitMQ": {
    "QueueName": "msa.payment"
  },
  "PaymentEndpoints": { "NotifyBaseUrl": "https://localhost:10005/payment/callbacks" },
  "PaymentProcessing": {
    "PaymentLifetime": "00:15:00",
    "ProviderOperationBatchSize": 25,
    "ProviderOperationConcurrency": 8,
    "ProviderOperationMaxAttempts": 10,
    "ProviderOperationPollingInterval": "00:00:02",
    "ProviderOperationLockDuration": "00:02:00",
    "ProviderCallTimeout": "00:00:30",
    "MaximumRetryDelay": "00:05:00",
    "ExpiryBatchSize": 100,
    "ExpiryPollingInterval": "00:00:15"
  },
  "Paylinks": {
    "Alipay": {
      "ServerUrl": "https://openapi.alipay.com",
      "AppId": "",
      "AppPrivateKey": "",
      "AlipayPublicKey": ""
    },
    "WeChatPay": {
      "ServerUrl": "https://api.mch.weixin.qq.com",
      "AppId": "",
      "MchId": "",
      "MchSerialNo": "",
      "MchPrivateKey": "",
      "APIv3Key": "",
      "WeChatPayPublicKey": "",
      "WeChatPayPublicKeyId": ""
    }
  },
  "ServiceAuthentication": {
    "ClientId": "MSA_Svc_Payment_Test",
    "AllowUntrustedCertificates": false
  },
  "GrpcClients": {
    "Order": {
      "Scopes": [
        "order"
      ],
      "Deadline": "00:00:02"
    }
  },
  "AllowedHosts": "*"
}
