<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 生成的代码不参与风格检查 -->
    <NoWarn>$(NoWarn);CS1591;IDE0005</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.AspNetCore.Server" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- 同一份契约同时生成服务端与客户端代码，避免两边手写重复定义 -->
    <Protobuf Include="Protos\**\*.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <!-- Adapters 里放契约的规范客户端适配（被多个服务复用的那几个），底层能力仍在 MSA.Grpc -->
    <ProjectReference Include="..\MSA.Grpc\MSA.Grpc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MSA.CommerceTests" />
  </ItemGroup>

</Project>
