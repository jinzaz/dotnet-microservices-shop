@UserService_HostAddress = http://localhost:12010
@accessToken = replace-with-access-token
@addressId = 00000000-0000-0000-0000-000000000000
@userId = replace-with-aspnet-core-user-id

### List my active addresses
GET {{UserService_HostAddress}}/api/user/me/addresses
Authorization: Bearer {{accessToken}}

### Create an address
POST {{UserService_HostAddress}}/api/user/me/addresses
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "label": "家",
  "recipientName": "张三",
  "phoneNumber": "13800138000",
  "countryCode": "CN",
  "province": "上海市",
  "city": "上海市",
  "district": "浦东新区",
  "street": "世纪大道 100 号 1 栋 1001 室",
  "postalCode": "200120",
  "makeDefault": true
}

### Get one address
GET {{UserService_HostAddress}}/api/user/me/addresses/{{addressId}}
Authorization: Bearer {{accessToken}}

### Get my point balance
GET {{UserService_HostAddress}}/api/user/me/points
Authorization: Bearer {{accessToken}}

### Get my point ledger
GET {{UserService_HostAddress}}/api/user/me/points/entries?skip=0&take=50
Authorization: Bearer {{accessToken}}

### Admin adjusts points; businessKey is idempotent per user
POST {{UserService_HostAddress}}/api/user/{{userId}}/points/adjustments
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "delta": 100,
  "businessKey": "ADMIN-CAMPAIGN-2026-001",
  "source": "AdminCampaign",
  "reason": "周年活动赠送"
}
