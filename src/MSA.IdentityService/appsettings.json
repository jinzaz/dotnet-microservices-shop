{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Issuer": "https://localhost:10002/"
  },
  "IdentityUi": {
    "BaseUrl": "http://localhost:5174/"
  },
