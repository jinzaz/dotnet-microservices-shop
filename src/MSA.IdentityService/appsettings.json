  "ConnectionStrings": {
    "DefaultConnection": "Database=IdentityDb",
    "Certificates": "Database=CertificateDb",
    "Redis": "defaultDatabase=1"
  },
  "Certificates": {
    "Consumer": "identity"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Sms": {
    "Provider": "",
    "LoginTemplate": "login-code",
    "PasswordResetTemplate": "password-reset-code",
    "PhoneConfirmationTemplate": "phone-confirmation-code",
    "CodeLifetimeSeconds": 300,
    "ResendCooldownSeconds": 60,
    "MaxSendsPerHour": 5,
    "MaxVerificationAttempts": 5
  },
  "Throttling": {
    "Authentication": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Registration": { "PermitLimit": 10, "WindowSeconds": 3600 },
    "SmsDispatch": { "PermitLimit": 5, "WindowSeconds": 600 },
    "LoginFailures": { "PermitLimit": 5, "WindowSeconds": 900 }
  },
  "OpenTelemetry": {
    "EnableConsoleExporter": true
  }
}
