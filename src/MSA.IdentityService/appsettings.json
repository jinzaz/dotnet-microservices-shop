{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Issuer": "https://localhost:10002/"
  },
  "IdentityUi": {
    "BaseUrl": "http://localhost:5174/"
  },
  "OpenIddict": {
    "Applications": [
      {
        "ClientId": "MSA_Bff_Web",
        "DisplayName": "MSA BFF Web",
        "ConsentType": "implicit",
        "Flows": [
          "authorization_code",
          "refresh_token"
        ],
        "Scopes": [
          "openid",
          "profile",
          "email",
          "roles",
          "offline_access",
          "auth",
          "user",
          "catalog",
          "inventory",
          "notification",
          "basket",
          "order",
          "payment"
        ],
        "RedirectUris": [
          "https://localhost:10008/api/bff/callback/login"
        ],
        "PostLogoutRedirectUris": [
          "https://localhost:10008/api/bff/callback/logout"
        ]
      },
      {
        "ClientId": "MSA_Bff_BM",
        "DisplayName": "MSA BFF Business Manager",
        "ConsentType": "explicit",
        "Flows": [
          "authorization_code",
          "refresh_token"
        ],
        "Scopes": [
          "openid",
          "profile",
          "email",
          "roles",
          "offline_access",
          "auth.admin.read",
          "auth.admin.write",
          "user.admin.read",
          "user.admin.write",
          "catalog.admin.read",
          "catalog.admin.write",
          "inventory.admin.read",
          "inventory.admin.write",
          "notification.admin.read",
          "notification.admin.write",
          "basket.admin.read",
          "basket.admin.write",
          "order.admin.read",
          "order.admin.write",
          "payment.admin.read",
          "payment.admin.write"
        ],
        "RedirectUris": [
          "https://localhost:10009/api/bff/callback/login"
        ],
        "PostLogoutRedirectUris": [
          "https://localhost:10009/api/bff/callback/logout"
        ]
      },
      {
        "ClientId": "MSA_Svc_Order",
        "DisplayName": "MSA Order Service (machine to machine)",
        "ConsentType": "implicit",
        "Flows": [
          "client_credentials"
        ],
        "Scopes": [
          "catalog",
          "inventory",
          "payment",
          "user"
        ],
        "RedirectUris": [],
        "PostLogoutRedirectUris": []
      },
      {
        "ClientId": "MSA_Svc_Basket",
        "DisplayName": "MSA Basket Service (machine to machine)",
        "ConsentType": "implicit",
        "Flows": [
          "client_credentials"
        ],
        "Scopes": [
          "catalog"
        ],
        "RedirectUris": [],
        "PostLogoutRedirectUris": []
      },
      {
        "ClientId": "MSA_Svc_Payment",
        "DisplayName": "MSA Payment Service (machine to machine)",
        "ConsentType": "implicit",
        "Flows": [
          "client_credentials"
        ],
        "Scopes": [
          "order"
        ],
        "RedirectUris": [],
        "PostLogoutRedirectUris": []
      },
      {
        "ClientId": "MSA_Svc_BffWeb",
        "DisplayName": "MSA Web BFF (machine to machine)",
        "ConsentType": "implicit",
        "Flows": [
          "client_credentials"
        ],
        "Scopes": [
          "inventory"
        ],
        "RedirectUris": [],
        "PostLogoutRedirectUris": []
      },
      {
        "ClientId": "MSA_Svc_BffBm",
        "DisplayName": "MSA BM BFF (machine to machine)",
        "ConsentType": "implicit",
        "Flows": [
          "client_credentials"
        ],
        "Scopes": [
          "order",
          "payment",
          "inventory"
        ],
        "RedirectUris": [],
        "PostLogoutRedirectUris": []
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Database=IdentityDb"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Sms": {
    "Provider": "",
    "LoginTemplate": "login-code",
    "PasswordResetTemplate": "password-reset-code",
    "PhoneConfirmationTemplate": "phone-confirmation-code",
    "CodeLifetimeSeconds": 300,
    "ResendCooldownSeconds": 60,
    "MaxSendsPerHour": 5,
    "MaxVerificationAttempts": 5
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://192.168.1.50:4317",
    "EnableConsoleExporter": true
  }
}
