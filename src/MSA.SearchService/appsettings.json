{
  "Authentication": { "Issuer": "https://localhost:10002/", "InternalAddress": "https://localhost:10002/" },
  "Elasticsearch": {
    "Alias": "catalog-products",
    "IndexTokenizer": "ik_max_word",
    "SearchTokenizer": "ik_smart",
    "Shards": 1,
    "Replicas": 1,
    "SearchTimeout": "00:00:00.800",
    "ExportPageSize": 500,
    "Synonyms": [
      "手机, 智能手机",
      "笔记本, 笔记本电脑",
      "耳机, 耳麦",
      "充电宝, 移动电源",
      "T恤, 短袖",
      "运动鞋, 跑鞋",
      "电饭煲, 电饭锅"
    ]
  },
  "RabbitMQ": {
    "QueueName": "msa.search",
    "PrefetchCount": 16,
    "MaxDeliveryAttempts": 60,
    "RetryDelay": "00:00:30"
  },
  "ServiceAuthentication": {
    "ClientId": "MSA_Svc_Search_Test",
    "AllowUntrustedCertificates": false
  },
  "GrpcClients": {
    "Catalog": {
      "Scopes": [ "catalog" ],
      "Deadline": "00:00:15"
    }
  },
  "AllowedHosts": "*"
}
