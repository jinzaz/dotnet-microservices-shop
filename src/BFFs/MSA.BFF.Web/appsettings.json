{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Redis": "defaultDatabase=7",
    "Postgresql": "Database=BFFDb"
  },
  "AllowedHosts": "*",
  "ServiceAuthentication": {
    "ClientId": "MSA_Svc_BffWeb",
    "AllowUntrustedCertificates": false
  },
  "GrpcClients": {
    "Inventory": {
      "Scopes": [ "inventory" ],
      "Deadline": "00:00:03"
    }
  },
  "Bff": {
    "FrontendBaseUrl": "http://localhost:5173/"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "ReverseProxy": {
    "Routes": {
      "gateway": {
        "ClusterId": "gateway",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "gateway": {
        "Destinations": {
          "default": {
            "Address": "https://localhost:10000"
          }
        }
      }
    }
  },
  "OpenIddict": {
    "Issuer": "https://localhost:10002/",
    "InternalAddress": "https://localhost:10002/",
    "ClientId": "MSA_Bff_Web_Test",
    "RedirectUri": "bff/callback/login",
    "PostLogoutRedirectUri": "bff/callback/logout",
    "Scopes": [ "user", "catalog", "inventory", "notification", "basket", "order", "payment" ]
  }
}
