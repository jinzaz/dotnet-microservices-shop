{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Redis": "defaultDatabase=7",
    "Postgresql": "Database=BFFDb"
  },
  "AllowedHosts": "*",
  "Bff": {
    "FrontendBaseUrl": "http://localhost:5175/"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Pbac": {
    "BootstrapAdminUserIds": [ "fb650d7e-0230-4117-b0e3-ae3ff8d1c72c" ]
  },
  "ReverseProxy": {
    "Routes": {
      "gateway": {
        "ClusterId": "gateway",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "gateway": {
        "Destinations": {
          "default": {
            "Address": "https://localhost:10000"
          }
        }
      }
    }
  },
  "OpenIddict": {
    "Issuer": "https://localhost:10002/",
    "InternalAddress": "https://localhost:10002/",
    "ClientId": "MSA_Bff_BM_Test",
    "RedirectUri": "bff/callback/login",
    "PostLogoutRedirectUri": "bff/callback/logout",
    "Scopes": [
      "auth.admin.read",
      "auth.admin.write",
      "user.admin.read",
      "user.admin.write",
      "catalog.admin.read",
      "catalog.admin.write",
      "inventory.admin.read",
      "inventory.admin.write",
      "notification.admin.read",
      "notification.admin.write",
      "basket.admin.read",
      "basket.admin.write",
      "order.admin.read",
      "order.admin.write",
      "payment.admin.read",
      "payment.admin.write"
    ]
  },
  "ServiceAuthentication": {
    "ClientId": "MSA_Svc_BffBm",
    "AllowUntrustedCertificates": false
  },
  "GrpcClients": {
    "Order": {
      "Scopes": [ "order" ],
      "Deadline": "00:00:03"
    },
    "Payment": {
      "Scopes": [ "payment" ],
      "Deadline": "00:00:03"
    },
    "Inventory": {
      "Scopes": [ "inventory" ],
      "Deadline": "00:00:03"
    }
  },
  "ObjectStorage": {
    "PublicBucket": "shop-public",
    "PrivateBucket": "shop-private"
  }
}
