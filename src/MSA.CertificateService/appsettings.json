{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgresql": "Database=CertificateDb"
  },
  "Database": { "MigrateOnStartup": false },
  "Authentication": { "Issuer": "https://localhost:10002/", "InternalAddress": "https://localhost:10002/" },
  "Renewal": {
    "Interval": "01:00:00"
  },
  "Acme": {
    "DnsPropagationTimeout": "00:03:00",
    "ValidationTimeout": "00:03:00"
  },
  "Tls": {
    "DeployDirectory": ""
  },
  "AllowedHosts": "*"
}
