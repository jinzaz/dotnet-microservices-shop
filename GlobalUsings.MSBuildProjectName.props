<Project>
	<Import Condition="Exists('$(MSBuildThisFileDirectory)src\Shared\GlobalUsings.$(MSBuildProjectName).props')"
			Project="$(MSBuildThisFileDirectory)src\Shared\GlobalUsings.$(MSBuildProjectName).props" />
	<ItemGroup>
		<None Condition="Exists('$(MSBuildThisFileDirectory)src\Shared\GlobalUsings.$(MSBuildProjectName).props')"
			  Include="$(MSBuildThisFileDirectory)src\Shared\GlobalUsings.$(MSBuildProjectName).props">
			<LinkBase>Properties\GlobalUsings</LinkBase>
		</None>
	</ItemGroup>
</Project>
