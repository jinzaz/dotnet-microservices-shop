// 认证中心在 Docker 部署下的覆盖配置：挂载为 /app/appsettings.<ASPNETCORE_ENVIRONMENT>.json，
// 叠加在镜像自带的 appsettings.json 之上。启动时按这里的列表创建 / 更新 OpenIddict 客户端。
//
// 数组按下标合并，所以这里写的是完整的客户端列表（顺序与镜像里一致），不要只写其中几项。
// 部署前需要改的：
//   1. 两个 BFF 的回调地址：BFF 与前端同域（入口代理把前端域名下的 /api、/bff 转给 BFF），所以是商城 / 后台前端的域名（与 .env 的 MSA_STORE_FRONTEND_URL / MSA_ADMIN_FRONTEND_URL 一致）。
//   2. 客户端密钥不在这里：来自环境变量 MSA_CLIENT_SECRET_<ClientId 大写>（.env），认证中心与取令牌的服务读同一个变量。
{
  "OpenIddict": {
    "Applications": [
      {
        "ClientId": "MSA_Bff_Web",
        "DisplayName": "MSA BFF Web",
        "ConsentType": "implicit",
        "Flows": [ "authorization_code", "refresh_token" ],
        "Scopes": [
          "openid", "profile", "email", "roles", "offline_access",
          "auth", "user", "catalog", "inventory", "notification", "basket", "order", "payment"
        ],
        "RedirectUris": [ "https://shop.msa.test.com/bff/callback/login" ],
        "PostLogoutRedirectUris": [ "https://shop.msa.test.com/bff/callback/logout" ]
      },
      {
        "ClientId": "MSA_Bff_BM",
        "DisplayName": "MSA BFF Business Manager",
        "ConsentType": "explicit",
        "Flows": [ "authorization_code", "refresh_token" ],
        "Scopes": [
          "openid", "profile", "email", "roles", "offline_access",
          "auth.admin.read", "auth.admin.write", "user.admin.read", "user.admin.write",
          "catalog.admin.read", "catalog.admin.write", "inventory.admin.read", "inventory.admin.write",
          "notification.admin.read", "notification.admin.write", "basket.admin.read", "basket.admin.write",
          "order.admin.read", "order.admin.write", "payment.admin.read", "payment.admin.write"
        ],
        "RedirectUris": [ "https://admin.msa.test.com/bff/callback/login" ],
        "PostLogoutRedirectUris": [ "https://admin.msa.test.com/bff/callback/logout" ]
      },
      {
        "ClientId": "MSA_Svc_Order",
        "DisplayName": "MSA Order Service (machine to machine)",
        "ConsentType": "implicit",
        "Flows": [ "client_credentials" ],
        "Scopes": [ "catalog", "inventory", "payment", "user" ],
        "RedirectUris": [],
        "PostLogoutRedirectUris": []
      },
      {
        "ClientId": "MSA_Svc_Basket",
        "DisplayName": "MSA Basket Service (machine to machine)",
        "ConsentType": "implicit",
        "Flows": [ "client_credentials" ],
        "Scopes": [ "catalog" ],
        "RedirectUris": [],
        "PostLogoutRedirectUris": []
      },
      {
        "ClientId": "MSA_Svc_Payment",
        "DisplayName": "MSA Payment Service (machine to machine)",
        "ConsentType": "implicit",
        "Flows": [ "client_credentials" ],
        "Scopes": [ "order" ],
        "RedirectUris": [],
        "PostLogoutRedirectUris": []
      },
      {
        "ClientId": "MSA_Svc_BffWeb",
        "DisplayName": "MSA Web BFF (machine to machine)",
        "ConsentType": "implicit",
        "Flows": [ "client_credentials" ],
        "Scopes": [ "inventory" ],
        "RedirectUris": [],
        "PostLogoutRedirectUris": []
      },
      {
        "ClientId": "MSA_Svc_BffBm",
        "DisplayName": "MSA BM BFF (machine to machine)",
        "ConsentType": "implicit",
        "Flows": [ "client_credentials" ],
        "Scopes": [ "order", "payment", "inventory" ],
        "RedirectUris": [],
        "PostLogoutRedirectUris": []
      }
    ]
  }
}
