// API 网关在 Docker 部署下的覆盖配置：挂载为 /app/appsettings.<ASPNETCORE_ENVIRONMENT>.json，
// 叠加在镜像自带的 appsettings.json 之上（原有路由、健康检查、超时等沿用镜像里的定义）。
// 各服务只在 dotnet-infra_backend 网络内以明文 HTTP 8080 提供 REST，容器名即主机名。
//
// 入口 nginx（nginx/msa.conf）只把认证中心的请求转给网关（商城 / 后台直接到各自的 BFF）：
//   identity.msa.test.com  /connect、/.well-known、/api/Auth → 认证中心
// 下面带 Hosts 的 edge-identity-* 路由 Order 更小，优先于镜像里不带 Hosts 的路由，并保留原始 Host（RequestHeaderOriginalHost）。
// 换域名时改这里的 Hosts，与 .env 的 MSA_ISSUER 保持一致。
{
  "ReverseProxy": {
    "Routes": {
      "edge-identity-connect": {
        "ClusterId": "identity",
        "Order": -10,
        "Match": {
          "Hosts": [ "identity.msa.test.com" ],
          "Path": "/connect/{**catch-all}"
        },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "edge-identity-discovery": {
        "ClusterId": "identity",
        "Order": -10,
        "Match": {
          "Hosts": [ "identity.msa.test.com" ],
          "Path": "/.well-known/{**catch-all}"
        },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      // 登录页调用 /api/Auth/*，认证中心的控制器在 /Auth/*
      "edge-identity-auth": {
        "ClusterId": "identity",
        "Order": -10,
        "Match": {
          "Hosts": [ "identity.msa.test.com" ],
          "Path": "/api/Auth/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "RequestHeaderOriginalHost": "true" }
        ]
      },
      "order-default": {
        "ClusterId": "order-stable",
        "Match": { "Path": "/api/order/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "identity-default": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/Auth/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "user-default": {
        "ClusterId": "user",
        "Match": { "Path": "/api/user/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "basket-default": {
        "ClusterId": "basket",
        "Match": { "Path": "/api/basket/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "catalog-default": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/catalog/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "inventory-default": {
        "ClusterId": "inventory",
        "Match": { "Path": "/api/inventory/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "payment-default": {
        "ClusterId": "payment",
        "Match": { "Path": "/api/payment/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "notification-default": {
        "ClusterId": "notification",
        "Match": { "Path": "/api/notification/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      }
    },
    "Clusters": {
      "order-stable": {
        "Destinations": { "order-1": { "Address": "http://msa-order:8080/" } }
      },
      // 金丝雀没有单独部署时也指向同一个订单服务，避免带金丝雀标记的请求打到不存在的地址。
      "order-canary": {
        "Destinations": { "order-canary-1": { "Address": "http://msa-order:8080/" } }
      },
      "identity": {
        "Destinations": { "identity-1": { "Address": "http://msa-identity:8080/" } }
      },
      "user": {
        "Destinations": { "user-1": { "Address": "http://msa-user:8080/" } }
      },
      "basket": {
        "Destinations": { "basket-1": { "Address": "http://msa-basket:8080/" } }
      },
      "catalog": {
        "Destinations": { "catalog-1": { "Address": "http://msa-catalog:8080/" } }
      },
      "inventory": {
        "Destinations": { "inventory-1": { "Address": "http://msa-inventory:8080/" } }
      },
      "payment": {
        "Destinations": { "payment-1": { "Address": "http://msa-payment:8080/" } }
      },
      "notification": {
        "Destinations": { "notification-1": { "Address": "http://msa-notification:8080/" } }
      }
    }
  }
}
