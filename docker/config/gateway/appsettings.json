// API 网关在 Docker 部署下的覆盖配置：挂载为 /app/appsettings.<ASPNETCORE_ENVIRONMENT>.json，
// 叠加在镜像自带的 appsettings.json 之上（路由、健康检查、超时等沿用镜像里的定义），这里只改集群地址。
// 各服务只在 dotnet-infra_backend 网络内以明文 HTTP 8080 提供 REST，容器名即主机名。
{
  "ReverseProxy": {
    "Clusters": {
      "order-stable": {
        "Destinations": { "order-1": { "Address": "http://msa-order:8080/" } }
      },
      // 金丝雀没有单独部署时也指向同一个订单服务，避免带金丝雀标记的请求打到不存在的地址。
      "order-canary": {
        "Destinations": { "order-canary-1": { "Address": "http://msa-order:8080/" } }
      },
      "identity": {
        "Destinations": { "identity-1": { "Address": "http://msa-identity:8080/" } }
      },
      "user": {
        "Destinations": { "user-1": { "Address": "http://msa-user:8080/" } }
      },
      "basket": {
        "Destinations": { "basket-1": { "Address": "http://msa-basket:8080/" } }
      },
      "catalog": {
        "Destinations": { "catalog-1": { "Address": "http://msa-catalog:8080/" } }
      },
      "inventory": {
        "Destinations": { "inventory-1": { "Address": "http://msa-inventory:8080/" } }
      },
      "payment": {
        "Destinations": { "payment-1": { "Address": "http://msa-payment:8080/" } }
      },
      "notification": {
        "Destinations": { "notification-1": { "Address": "http://msa-notification:8080/" } }
      }
    }
  }
}
