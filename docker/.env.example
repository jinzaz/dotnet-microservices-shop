# 复制为 .env 后修改。含 $ 等特殊字符的值用单引号包起来，Compose 会原样使用。

# ---- 运行环境 ----
ASPNETCORE_ENVIRONMENT=Production
# 镜像仓库：scripts/build-images.* 推送到这里，compose 从这里拉取（Harbor 走 HTTP，见 README）。
MSA_IMAGE_REGISTRY=harbor.local/msa-shop
# 运行哪个版本：latest，或构建脚本打的 git 短哈希 / 版本号
MSA_IMAGE_TAG=latest
# missing：本地没有才拉；always：每次 up 都拉（跟踪 latest 时用）
MSA_PULL_POLICY=missing
# 启动时自动执行 EF 迁移
MSA_MIGRATE_ON_STARTUP=false

# ---- 内存与 GC（见 README「.NET GC 与内存」）----
# 容器内存上限：普通服务 / 流量大的服务（网关、两个 BFF、认证中心、订单、目录）。GC 堆上限自动取它的 75%。
MSA_MEM_LIMIT=320m
MSA_MEM_LIMIT_LARGE=448m
# 0 = Workstation GC（小机器、一机多服务）；1 = Server GC（核多、单独部署的大流量服务）
MSA_DOTNET_GC_SERVER=0
# 0~9，越大越积极压缩大对象堆省内存；0 不开
MSA_DOTNET_GC_CONSERVE_MEMORY=0

# ---- 对外地址 ----
# 所有服务只在 dotnet-infra_backend 网络内以明文 HTTP 提供，不映射端口；对外由入口代理（Nginx / Traefik 等）
# 按域名终止 TLS 后转发到容器（BFF、认证中心、支付回调）。下面这些都是浏览器看到的 HTTPS 地址。
MSA_DOMAIN=msa.test.com
# 认证中心：浏览器跳转登录用的是这个公网地址，令牌里的 iss 也必须是它（校验令牌时拿来比对）。
MSA_ISSUER=https://identity.${MSA_DOMAIN}/
# 认证中心的容器内地址：各服务校验令牌拉 JWKS、取服务间调用令牌都直连它，不经入口代理绕一圈。必填，缺了服务启动直接失败。
MSA_IDENTITY_INTERNAL_ADDRESS=http://msa-identity:8080
# 前端站点：静态页面与它的 BFF 同域（入口代理把这个域名下的 /api、/bff 转给 msa-bff-web / msa-bff-bm），
# 所以 BFF 的登录回调也在这个域名下（config/identity/appsettings.json 的 RedirectUris）。
MSA_STORE_FRONTEND_URL=https://shop.${MSA_DOMAIN}/
MSA_ADMIN_FRONTEND_URL=https://admin.${MSA_DOMAIN}/
# 认证中心的登录页（MSA.Web/Identity 静态页面）必须与 MSA_ISSUER 同域：登录 Cookie 只属于这个域名，
# 换成别的域名后 /connect/authorize 读不到它，每次都要重新登录。
MSA_IDENTITY_UI_URL=${MSA_ISSUER}
# 支付渠道异步通知回调的基地址
MSA_PAYMENT_NOTIFY_BASE_URL=https://payment.${MSA_DOMAIN}/payment/callbacks
# 两个 BFF 的登录回调地址写在 config/identity/appsettings.json（OpenIddict 客户端注册）里，改域名时一并修改；
# 前端打包时的域名（VITE_STORE_URL / VITE_STOREFRONT_URL）在 src/MSA.Web/*/.env.production 里。
# OpenIddict 密钥证书的口令不在这里：scripts/new-openiddict-certs.* 随机生成并写进 certs/cert-passwords.env。

# ---- 可观测性：OTLP gRPC 端点（OTel Collector / Aspire Dashboard / Jaeger 等）----
MSA_OTLP_ENDPOINT=http://monitor-otel-collector:4317

# ---- gRPC 下游地址（容器名 + HTTP/2 专用端口 8081）→ GrpcClients:<名称>:Address ----
# 按被调用的服务命名，调用它的服务共用一个变量；与 msa.env 同名。
MSA_GRPC_ORDER_ADDRESS=http://msa-order:8081
MSA_GRPC_CATALOG_ADDRESS=http://msa-catalog:8081
MSA_GRPC_INVENTORY_ADDRESS=http://msa-inventory:8081
MSA_GRPC_PAYMENT_ADDRESS=http://msa-payment:8081
MSA_GRPC_USER_ADDRESS=http://msa-user:8081

# ---- 服务间调用 ----
# 取服务令牌（client_credentials）的授权地址 → ServiceAuthentication:Authority；后端对后端，直连容器内地址。
MSA_SERVICE_AUTHORITY=${MSA_IDENTITY_INTERNAL_ADDRESS}
# OpenIddict 客户端密钥：MSA_CLIENT_SECRET_<ClientId 大写>。认证中心按它注册客户端，各服务 / BFF 用它取令牌，
# compose 只把各自的那一个注入对应容器（认证中心拿全部）。生产环境用新的随机值，例如 [guid]::NewGuid() / uuidgen。
MSA_CLIENT_SECRET_MSA_BFF_WEB=A4517BB5-02BE-4EF9-AAA4-4C2838FDB3FD
MSA_CLIENT_SECRET_MSA_BFF_BM=785AEC87-C981-451E-9A7A-0D60AC10AB9F
MSA_CLIENT_SECRET_MSA_SVC_ORDER=8E1C9E57-6F2B-4E5D-9C2E-7A1B0D3F5A64
MSA_CLIENT_SECRET_MSA_SVC_BASKET=5D7C3B92-11A4-4E8F-8C6D-3F9B2E5A7D48
MSA_CLIENT_SECRET_MSA_SVC_PAYMENT=B4F0A1D2-58C3-4E77-9B10-2E6A7C4D9F31
MSA_CLIENT_SECRET_MSA_SVC_BFFWEB=3C6F9A18-2D47-4B5E-8F01-7A9E4C2B6D55
MSA_CLIENT_SECRET_MSA_SVC_BFFBM=9A2E5C71-64B8-4D3F-A7E9-1C8B0F6D4E23
MSA_CLIENT_SECRET_MSA_SVC_SEARCH=6B1D4E92-3A7C-4F05-8E2B-C9D17A5F0E36
MSA_CLIENT_SECRET_MSA_AGENT_WEB=2F8D6A13-9C4E-4B71-A5D2-7E0B3C9F1A86

# ---- Elasticsearch（商品搜索服务 msa-search；需安装 IK 分词插件，见 docker/elasticsearch）----
# 默认走容器内网明文（ES 只加入 dotnet-infra_backend、不映射端口）。生产用最小权限的 API Key（创建命令见
# docker/elasticsearch/README.md），不要用 elastic 超级用户；填了 API Key 时用户名口令不再使用。
INFRA_ELASTICSEARCH_URL=http://elasticsearch:9200
INFRA_ELASTICSEARCH_API_KEY=
INFRA_ELASTICSEARCH_USER=elastic
INFRA_ELASTICSEARCH_PASSWORD=
# TLS（ES 跨机器部署时）：ES 打开 docker/elasticsearch/compose.yaml 里注释掉的 TLS 配置，把 CA 拷到 docker/certs/es-http-ca.crt，
# 再打开 services/commerce/search.yaml 里的证书挂载，改用下面两行：
# INFRA_ELASTICSEARCH_URL=https://elasticsearch:9200
# INFRA_ELASTICSEARCH_CA_CERT=/certs/es-http-ca.crt
INFRA_ELASTICSEARCH_CA_CERT=

# ---- 证书库（CertificateDb，由 msa-certificate 管理）----
# 每个使用方一把 KEK：32 字节 base64，用 `openssl rand -base64 32` 生成。加密证书库里它名下的私钥和 DataProtection 密钥环。
# 证书服务拿全部四个，认证中心 / 两个 BFF 只注入各自的那一个（见 services/*.yaml）。必填，缺了服务起不来。
# 生成后与数据库备份分开保管：丢了 KEK，库里对应的私钥就再也解不开；换 KEK 前要先导出 / 重新导入证书。
MSA_CERT_KEK_IDENTITY=
MSA_CERT_KEK_BFF_WEB=
MSA_CERT_KEK_BFF_BM=
MSA_CERT_KEK_EDGE=
# 站点 TLS 证书的部署目录（宿主机绝对路径）：证书服务写 <站点名>/fullchain.pem、privkey.pem，nginx 以只读方式挂载同一目录。
# 证书服务容器以非 root 用户（UID 1654）运行，目录要给它写权限：chown 1654 /srv/msa/tls。
MSA_TLS_DEPLOY_DIR=/base/certs/msa
# Let's Encrypt DNS-01 验证（通配符证书只能用它）：只填你的域名所在的那一家，没填的在后台不可选。
# 阿里云：RAM 用户授予 AliyunDNSFullAccess；Cloudflare：API Token 授予 Zone.DNS 编辑；
# 腾讯云 DNSPod：CAM 子用户授予 QcloudDNSPodFullAccess，填它的 SecretId / SecretKey（访问管理 → API 密钥）。
# 大陆服务器未备案时 80 端口会被拦截，HTTP-01 必然失败，只能用 DNS-01。
MSA_ACME_ALIYUN_ACCESS_KEY_ID=
MSA_ACME_ALIYUN_ACCESS_KEY_SECRET=
MSA_ACME_CLOUDFLARE_API_TOKEN=
MSA_ACME_DNSPOD_SECRET_ID=
MSA_ACME_DNSPOD_SECRET_KEY=
# 阿里云号码认证服务「短信认证」：RAM 用户授予 dypns:SendSmsVerifyCode。
# 只在 config/identity/appsettings.json 里 Sms:Provider = aliyun 时使用，此时必填，缺了认证中心起不来。
MSA_SMS_ALIYUN_ACCESS_KEY_ID=
MSA_SMS_ALIYUN_ACCESS_KEY_SECRET=

# ---- 基础设施（dotnet-infra 项目）----
# 变量名与仓库根目录 msa.env（本地开发）相同，应用启动时合并进各自的连接串 / RabbitMQ / 对象存储配置。
# 如果基础设施容器也在 dotnet-infra_backend 网络里，可以直接写它们的容器名，例如 postgres / redis / rabbitmq。
INFRA_POSTGRES_HOST=base-postgres
INFRA_POSTGRES_PORT=5432
INFRA_POSTGRES_USER=postgres
INFRA_POSTGRES_PASSWORD='qwertAa!@#$'
# 每个连接串的连接池上限（Npgsql 默认 100）。全部服务的池加起来要小于 PostgreSQL 的 max_connections：
# 目前共 17 个池（认证中心、两个 BFF 各 3 个，其余 8 个服务各 1 个），15 × 17 = 255，再加迁移 / 运维连接的余量。
# 池是按需建连、空闲 5 分钟回收的，平时实际连接数远低于这个值，这只是峰值的上限。
# 在 Grafana 里看 Npgsql 指标 db.client.connections.usage / pending_requests 再调。
INFRA_POSTGRES_MAX_POOL_SIZE=15

INFRA_REDIS_HOST=base-redis
INFRA_REDIS_PORT=6379
INFRA_REDIS_PASSWORD='qwertAaQAQ'

INFRA_RABBITMQ_HOST=base-rabbitmq
INFRA_RABBITMQ_PORT=5672
INFRA_RABBITMQ_USER=admin
INFRA_RABBITMQ_PASSWORD='qwertAa!@#$'
INFRA_RABBITMQ_VHOST=/app

# 对象存储（RustFS，S3 兼容），只有后台 BFF 使用。它签出的上传地址和商品图片地址都直接给浏览器用，
# 所以这里是入口代理对外的 HTTPS 地址（nginx/msa.conf 的 oss 站点再转给 base-rustfs:9000），不是容器内地址。
INFRA_OSS_ENDPOINT=https://oss.${MSA_DOMAIN}
INFRA_OSS_ACCESS_KEY=lIsrAuRBWT0huAHS7Kzl
INFRA_OSS_SECRET_KEY=Nokx3fRO0InDWLMLeecvgO1LKZomBfpzG6C7NCmj
# 换成腾讯云 COS：ENDPOINT 填 https://cos.<地域>.myqcloud.com，桶名带 APPID（如 shop-public-1250000000，写在各服务 appsettings 的 ObjectStorage 里），
# 新桶只认虚拟主机风格；两个桶开了 Referer 防盗链时，服务端请求要带白名单里的地址，否则 HEAD/DELETE 被 403。
# INFRA_OSS_REGION=ap-guangzhou
# INFRA_OSS_FORCE_PATH_STYLE=false
# INFRA_OSS_REFERER=https://admin.${MSA_DOMAIN}/
