# 复制为 .env 后修改。含 $ 等特殊字符的值用单引号包起来，Compose 会原样使用。

# ---- 运行环境 ----
ASPNETCORE_ENVIRONMENT=Production
# 镜像仓库：scripts/build-images.* 推送到这里，compose 从这里拉取（Harbor 走 HTTP，见 README）。
MSA_IMAGE_REGISTRY=harbor.local/msa-shop
# 运行哪个版本：latest，或构建脚本打的 git 短哈希 / 版本号
MSA_IMAGE_TAG=latest
# missing：本地没有才拉；always：每次 up 都拉（跟踪 latest 时用）
MSA_PULL_POLICY=missing
# 启动时自动执行 EF 迁移
MSA_MIGRATE_ON_STARTUP=false

# ---- 对外地址 ----
# 所有服务只在 dotnet-infra_backend 网络内以明文 HTTP 提供，不映射端口；对外由入口代理（Nginx / Traefik 等）
# 按域名终止 TLS 后转发到容器（BFF、认证中心、支付回调）。下面这些都是浏览器看到的 HTTPS 地址。
MSA_DOMAIN=msa.test.com
# 认证中心：浏览器跳转登录、各服务校验令牌与取服务令牌用的是同一个地址（容器内也要能经入口代理访问到它）
MSA_ISSUER=https://identity.${MSA_DOMAIN}/
# 前端站点（登录、注销后跳回的地址）
MSA_STORE_FRONTEND_URL=https://shop.${MSA_DOMAIN}/
MSA_ADMIN_FRONTEND_URL=https://admin.${MSA_DOMAIN}/
MSA_IDENTITY_UI_URL=https://auth.${MSA_DOMAIN}/
# 支付渠道异步通知回调的基地址
MSA_PAYMENT_NOTIFY_BASE_URL=https://payment.${MSA_DOMAIN}/payment/callbacks
# 两个 BFF 的登录回调地址写在 config/identity/appsettings.json（OpenIddict 客户端注册）里，改域名时一并修改。
# OpenIddict 密钥证书的口令不在这里：scripts/new-openiddict-certs.* 随机生成并写进 certs/cert-passwords.env。

# ---- 可观测性：OTLP gRPC 端点（OTel Collector / Aspire Dashboard / Jaeger 等）----
MSA_OTLP_ENDPOINT=http://otel-collector:4317

# ---- 服务间调用 ----
# 取服务令牌（client_credentials）的授权地址 → ServiceAuthentication:Authority
MSA_SERVICE_AUTHORITY=${MSA_ISSUER}
# OpenIddict 客户端密钥：MSA_CLIENT_SECRET_<ClientId 大写>。认证中心按它注册客户端，各服务 / BFF 用它取令牌，
# compose 只把各自的那一个注入对应容器（认证中心拿全部）。生产环境用新的随机值，例如 [guid]::NewGuid() / uuidgen。
MSA_CLIENT_SECRET_MSA_BFF_WEB=A4517BB5-02BE-4EF9-AAA4-4C2838FDB3FD
MSA_CLIENT_SECRET_MSA_BFF_BM=785AEC87-C981-451E-9A7A-0D60AC10AB9F
MSA_CLIENT_SECRET_MSA_SVC_ORDER=8E1C9E57-6F2B-4E5D-9C2E-7A1B0D3F5A64
MSA_CLIENT_SECRET_MSA_SVC_BASKET=5D7C3B92-11A4-4E8F-8C6D-3F9B2E5A7D48
MSA_CLIENT_SECRET_MSA_SVC_PAYMENT=B4F0A1D2-58C3-4E77-9B10-2E6A7C4D9F31
MSA_CLIENT_SECRET_MSA_SVC_BFFWEB=3C6F9A18-2D47-4B5E-8F01-7A9E4C2B6D55
MSA_CLIENT_SECRET_MSA_SVC_BFFBM=9A2E5C71-64B8-4D3F-A7E9-1C8B0F6D4E23

# ---- 基础设施（dotnet-infra 项目）----
# 变量名与仓库根目录 msa.env（本地开发）相同，应用启动时合并进各自的连接串 / RabbitMQ / 对象存储配置。
# 如果基础设施容器也在 dotnet-infra_backend 网络里，可以直接写它们的容器名，例如 postgres / redis / rabbitmq。
INFRA_POSTGRES_HOST=base-postgres
INFRA_POSTGRES_PORT=5432
INFRA_POSTGRES_USER=postgres
INFRA_POSTGRES_PASSWORD='qwertAa!@#$'

INFRA_REDIS_HOST=base-redis
INFRA_REDIS_PORT=6379
INFRA_REDIS_PASSWORD='qwertAaQAQ'

INFRA_RABBITMQ_HOST=base-rabbitmq
INFRA_RABBITMQ_PORT=5672
INFRA_RABBITMQ_USER=admin
INFRA_RABBITMQ_PASSWORD='qwertAa!@#$'
INFRA_RABBITMQ_VHOST=/app

# 对象存储（MinIO / S3），只有后台 BFF 使用
INFRA_OSS_ENDPOINT=http://base-rustfs:9000
INFRA_OSS_ACCESS_KEY=lIsrAuRBWT0huAHS7Kzl
INFRA_OSS_SECRET_KEY=Nokx3fRO0InDWLMLeecvgO1LKZomBfpzG6C7NCmj
