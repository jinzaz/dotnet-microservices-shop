# 建议把 latest 换成具体版本号：tempo.yaml 按 Tempo 3.x 的配置结构写（backend_worker、live_store），
# 跨大版本升级时配置项可能改名，固定版本后再按发布说明升级。
OTEL_COLLECTOR_VERSION=latest
PROMETHEUS_VERSION=latest
TEMPO_VERSION=latest
LOKI_VERSION=3.7.0
# 13.x 起数据源插件解耦，跨大版本升级先看发布说明（见 docker-compose.yml 的 GF_PLUGINS_PREINSTALL_AUTO_UPDATE）。
GRAFANA_VERSION=13.3.0

# ---- 保留时长 ----
# Prometheus 按时间和大小两个条件保留，先到哪个就按哪个删最老的数据。
PROMETHEUS_RETENTION=7d
PROMETHEUS_RETENTION_SIZE=2GB
# Loki 必须是 24h 的整数倍。
LOKI_RETENTION=168h
TEMPO_RETENTION=72h

# ---- 链路采样（Collector 尾部采样）----
# 出错和超过 TRACE_SLOW_MS 的链路全部保留，其余按百分比保留。
TRACE_SAMPLING_PERCENT=20
TRACE_SLOW_MS=500

# ---- 容器内存上限（默认按 2C4G 设置，合计上限约 2G，实际占用通常不到一半）----
OTEL_MEM_LIMIT=256m
OTEL_MEMORY_LIMIT_MIB=200
OTEL_GOMEMLIMIT=200MiB
PROMETHEUS_MEM_LIMIT=512m
TEMPO_MEM_LIMIT=384m
LOKI_MEM_LIMIT=384m
LOKI_GOMEMLIMIT=300MiB
# Grafana 13 空闲约 200MiB，256m 会让它一直卡在 GC 上。
GRAFANA_MEM_LIMIT=512m
GRAFANA_GOMEMLIMIT=400MiB

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
